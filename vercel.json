{
  "functions": {
    "api/rest.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/rest-upload.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/api/rest", "dest": "/api/rest", "methods": ["POST", "OPTIONS"] },
    { "src": "/api/rest-upload", "dest": "/api/rest-upload", "methods": ["POST", "OPTIONS"] },
    { "src": "/(.*)", "dest": "/api/index", "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS", "HEAD"] }
  ]
}
